{
    "manifest_version": 3,
    "name": "cgpt_bookmark",
    "version": "0.1",
    "description": "Click a message to anchor to it.",
    "permissions": ["storage"],
    "host_permissions": [
      "https://chatgpt.com/*",
      "https://chat.openai.com/*"
    ],
    "content_scripts": [
      {
        "matches": [
          "https://chatgpt.com/*",
          "https://chat.openai.com/*"
        ],
        "js": ["content.js"],
        "run_at": "document_idle"
      }
    ]
  }